          "integer": true,
          "unit": "people",
          "min": 0,
          "max": 200,
          "required": true
        },
        {
          "key": "hired_labour",
          "label": "Hired labour",
          "type": "number",
          "integer": true,
          "unit": "people",
          "min": 0,
          "max": 1000,
          "required": true
        },
        {
          "key": "women_pickers",
          "label": "Women pickers",
          "type": "number",
          "integer": true,
          "unit": "people",
          "min": 0,
