        },
        {
          "key": "area_sprayed",
          "label": "Area sprayed",
          "type": "number",
          "unit": "acres",
          "min": 0,
          "max": 5000,
          "required": false
        },
        {
          "key": "pheromone_traps",
          "label": "Pheromone traps",
          "type": "number",
          "integer": true,
          "unit": "per acre",
          "min": 0,
          "max": 100,
          "required": false
        },
        {
          "key": "beneficial_insects",
          "label": "Beneficial insects seen",
          "type": "multiselect",
          "list_key": "beneficial_insects",
          "required": false
        }
      ],
      "rules": []
    },
    {
      "key": "energy",
      "title": "Energy",
      "order": 8,
      "repeatable": false,
      "required": true,
      "allow_not_applicable": false,
      "summary": "{total_diesel} L diesel, {grid_electricity} kWh",
      "fields": [
        {
          "key": "total_diesel",
          "label": "Total field diesel",
          "type": "number",
          "unit": "litres per season",
          "min": 0,
          "max": 20000,
          "required": true
        },
        {
          "key": "grid_electricity",
          "label": "Grid electricity",
          "type": "number",
          "unit": "kWh",
          "min": 0,
          "max": 200000,
          "required": true
        }
      ],
      "rules": []
    },
    {
      "key": "labour_social",
