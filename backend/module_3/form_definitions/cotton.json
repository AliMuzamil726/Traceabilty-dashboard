    {
      "key": "harvest",
      "title": "Harvest",
      "order": 10,
      "repeatable": true,
      "required": true,
      "allow_not_applicable": false,
      "summary": "{picking_number} picking on {picking_date}, {yield} maunds per acre",
      "totals": [
        {
          "label": "Pickings",
          "kind": "count"
        },
        {
          "label": "Total yield",
          "kind": "sum",
          "field": "yield",
          "unit": "maunds per acre"
        }
      ],
      "fields": [
        {
          "key": "picking_date",
          "label": "Picking date",
          "type": "date",
          "required": true
        },
        {
          "key": "picking_number",
          "label": "Picking number",
          "type": "select",
          "list_key": "picking_number",
          "required": true
        },
        {
          "key": "harvest_method",
          "label": "Harvest method",
          "type": "select",
          "list_key": "harvest_method_cotton",
          "required": true
        },
        {
          "key": "yield",
          "label": "Yield",
          "type": "number",
          "unit": "maunds per acre",
          "min": 0,
          "max": 100,
          "required": true,
          "help": "1 maund is 40 kg."
        },
        {
          "key": "moisture",
          "label": "Moisture",
          "type": "number",
          "unit": "%",
          "min": 0,
          "max": 40,
          "required": false,
          "warn_above": 12,
          "warn_message": "Moisture above 12 percent risks spoilage in storage."
        },
        {
          "key": "storage_material",
          "label": "Storage material",
          "type": "select",
          "list_key": "storage_material",
          "required": true,
          "warn_values": [
            "polypropylene_not_recommended"
          ],
          "warn_message": "Polypropylene sheets contaminate lint; cotton cloth or jute is recommended."
        },
        {
          "key": "ready_for_pickup",
          "label": "Ready for pickup",
          "type": "yesno",
          "list_key": "yes_no",
          "required": true
        }
      ],
      "rules": [
        {
