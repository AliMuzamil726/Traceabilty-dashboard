# SAWIE backend configuration. backend.bat copies this file to .env on first run.

# Database. SQLite now; later a Supabase Postgres URL such as
# postgresql+psycopg://user:password@host:5432/postgres
# Relative SQLite paths are resolved against the backend folder.
DATABASE_URL=sqlite:///./data/sawie.db

# development | test | production
APP_ENV=development

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URL of the web app. Every QR code encodes {PUBLIC_BASE_URL}/trace/{token}.
# localhost does NOT work on a phone: for field testing use this computer's LAN address,
# for example http://192.168.1.20:5173 (and start the web app so it listens on the LAN),
# or the real domain later. Reprint labels after changing it.
PUBLIC_BASE_URL=http://localhost:5173

# Salt for hashing scanner IP addresses in the QR scan log (never stored raw)
QR_IP_SALT=change-me-to-a-long-random-string

# Folder for uploaded files (relative to backend/)
UPLOAD_DIR=./storage

# Seed offices, officers and master lists on startup when tables are empty
SEED_ON_START=true

# Officer used in development when the X-Officer-Id header is missing
DEFAULT_OFFICER_CODE=PK-MUL-01

LOG_LEVEL=INFO
